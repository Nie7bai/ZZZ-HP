{
  "name": "zzz-hp",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:release-mult": "npx vite-node scripts/test-release-mult.mjs",
    "test:skill-coords": "npx vite-node scripts/test-skill-match-coords.mjs",
    "test:skill-migration": "npx vite-node scripts/test-skill-library-migration.mjs",
    "test:history-stats": "npx vite-node scripts/test-damage-calc-history-stats.mjs",
    "test:crisis-hp-score": "npx vite-node scripts/test-crisis-hp-score-convert.mjs",
    "test:mode-routes": "npx vite-node scripts/test-mode-panel-routes.mjs",
    "test:affix-preagg": "npx vite-node scripts/test-affix-preagg.mjs",
    "test:buff-catalog-cache": "npx vite-node scripts/test-buff-catalog-cache.mjs",
    "test:user-auth-session": "npx vite-node scripts/test-user-auth-session-race.mjs",
    "test:mult-factor-percent": "npx vite-node scripts/test-mult-factor-percent.mjs",
    "test:formula-align": "npx vite-node scripts/test-formula-align-compare.mjs",
    "test:sharpen-crit": "npx vite-node scripts/test-sharpen-crit.mjs",
    "test:guestbook-upload-session": "npx vite-node scripts/test-guestbook-upload-session.mjs",
    "test:skill-talent-levels": "npx vite-node scripts/test-skill-talent-levels.mjs",
    "test": "run-s test:release-mult test:skill-coords test:history-stats test:crisis-hp-score test:mode-routes test:affix-preagg test:buff-catalog-cache test:user-auth-session test:mult-factor-percent test:formula-align test:sharpen-crit test:guestbook-upload-session test:skill-talent-levels",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "isomorphic-dompurify": "^3.19.0",
    "markdown-it": "^14.3.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
